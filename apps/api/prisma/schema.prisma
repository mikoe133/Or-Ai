generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
  schemas  = ["orai"]
}

enum DataScope {
  DEMO
  LIVE

  @@schema("orai")
}

enum DatabaseEnvironment {
  DEVELOPMENT
  TEST
  PRODUCTION

  @@schema("orai")
}

enum ProductStatus {
  DRAFT
  REVIEWED
  PUBLISHED
  ARCHIVED

  @@schema("orai")
}

enum ExperienceType {
  SCORE
  TENDENCY

  @@schema("orai")
}

enum Platform {
  DOUYIN
  XIAOHONGSHU
  MANUAL

  @@schema("orai")
}

enum OrderStatus {
  PENDING
  FULFILLED
  REFUNDED
  CANCELLED

  @@schema("orai")
}

enum CodeStatus {
  ISSUED
  CLAIMED
  EXPIRED
  REVOKED

  @@schema("orai")
}

enum Ownership {
  ANONYMOUS
  ACCOUNT_BOUND

  @@schema("orai")
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED

  @@schema("orai")
}

enum UserRole {
  USER
  ADMIN

  @@schema("orai")
}

enum AttemptStatus {
  STARTED
  SUBMITTED
  COMPLETED
  INVALID

  @@schema("orai")
}

enum AssetKind {
  COVER
  VIDEO
  SCRIPT
  COPY
  EXPERIENCE

  @@schema("orai")
}

enum AssetStatus {
  DRAFT
  REVIEWED
  READY
  ARCHIVED

  @@schema("orai")
}

enum EventKind {
  VIEW
  REDEMPTION
  START
  COMPLETE
  REPORT_VIEW
  SHARE_EXPORT
  REFUND

  @@schema("orai")
}

enum EventSource {
  WEB
  MANUAL
  DEMO

  @@schema("orai")
}

model EnvironmentMarker {
  id           Int                 @id
  environment  DatabaseEnvironment
  databaseName String              @map("database_name")
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("environment_marker")
  @@schema("orai")
}

model Category {
  id        String    @id @default(uuid(7)) @db.Uuid
  slug      String    @unique
  name      String
  sortOrder Int       @default(0) @map("sort_order")
  revision  Int       @default(0)
  products  Product[]

  @@map("categories")
  @@schema("orai")
}

model Tag {
  id       String       @id @default(uuid(7)) @db.Uuid
  slug     String       @unique
  name     String
  revision Int          @default(0)
  products ProductTag[]

  @@map("tags")
  @@schema("orai")
}

model Product {
  id                  String           @id @default(uuid(7)) @db.Uuid
  slug                String           @unique
  name                String
  hook                String
  summary             String
  description         String
  categoryId          String           @map("category_id") @db.Uuid
  category            Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags                ProductTag[]
  scope               DataScope
  status              ProductStatus    @default(DRAFT)
  priceFen            Int              @map("price_fen")
  currency            String           @default("CNY")
  durationMinutes     Int              @map("duration_minutes")
  durationIsEstimate  Boolean          @default(true) @map("duration_is_estimate")
  experienceType      ExperienceType   @map("experience_type")
  themeKey            String           @map("theme_key")
  coverUrl            String?          @map("cover_url")
  publicSample        Json             @map("public_sample")
  purchaseUrl         String?          @map("purchase_url")
  purchaseNotice      String           @map("purchase_notice")
  redemptionNotice    String           @map("redemption_notice")
  recommended         Boolean          @default(false)
  revision            Int              @default(0)
  recommendationOrder Int              @default(0) @map("recommendation_order")
  currentVersionId    String?          @unique @map("current_version_id") @db.Uuid
  currentVersion      ProductVersion?  @relation("CurrentVersion", fields: [currentVersionId, id, scope], references: [id, productId, scope], onDelete: Restrict)
  versions            ProductVersion[] @relation("ProductVersions")
  creativeProfiles    CreativeProfileRevision[]
  machineProjects     MachineProject[]
  productionPlans     ProductionPlanRevision[]
  productionModules   ProductionModuleIdentity[]
  publishedAt         DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([id, scope])
  @@unique([currentVersionId, id, scope])
  @@index([scope, status, categoryId, publishedAt])
  @@index([scope, status, recommended, recommendationOrder])
  @@map("products")
  @@schema("orai")
  fileCleanups FileCleanupPlan[]
  projectReviews ProjectReviewRevision[]
  externalRuns ExternalProductionRun[]
}

model ProductTag {
  productId String  @map("product_id") @db.Uuid
  tagId     String  @map("tag_id") @db.Uuid
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([productId, tagId])
  @@index([tagId, productId])
  @@map("product_tags")
  @@schema("orai")
}

model ProductVersion {
  id            String           @id @default(uuid(7)) @db.Uuid
  productId     String           @map("product_id") @db.Uuid
  scope         DataScope
  product       Product          @relation("ProductVersions", fields: [productId, scope], references: [id, scope], onDelete: Restrict)
  currentFor    Product?         @relation("CurrentVersion")
  number        Int
  revision      Int              @default(0)
  status        ProductStatus    @default(DRAFT)
  configuration Json
  creativeProfileRevisionId String? @map("creative_profile_revision_id") @db.Uuid
  creativeProfile CreativeProfileRevision? @relation(fields: [creativeProfileRevisionId, productId, scope], references: [id, productId, scope], onDelete: Restrict, map: "version_creative_profile_scope_fkey")
  publishedAt   DateTime?        @map("published_at") @db.Timestamptz(3)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  orders        Order[]
  codes         RedemptionCode[]
  entitlements  Entitlement[]
  attempts      Attempt[]
  reports       Report[]
  questionStats QuestionStat[]
  resultStats   ResultStat?
  assets        CampaignAsset[]
  campaigns     Campaign[]
  events        Event[]
  files         AssetFile[]
  contentRevisions ContentRevision[]
  experienceRelease ExperienceRelease?
  experienceAuthoring ExperienceAuthoringRevision[]

  @@unique([productId, number])
  @@unique([id, scope])
  @@unique([id, productId, scope])
  @@index([productId, scope, status])
  @@map("product_versions")
  @@schema("orai")
}

model Order {
  id               String           @id @default(uuid(7)) @db.Uuid
  platform         Platform
  reference        String
  productVersionId String           @map("product_version_id") @db.Uuid
  scope            DataScope
  productVersion   ProductVersion   @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  quantity         Int              @default(1)
  amountFen        Int              @map("amount_fen")
  status           OrderStatus      @default(PENDING)
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  refundedAt       DateTime?        @map("refunded_at") @db.Timestamptz(3)
  codes            RedemptionCode[]
  entitlements     Entitlement[]
  batches          CodeBatch[]

  @@unique([platform, reference])
  @@unique([id, scope])
  @@unique([id, productVersionId, scope])
  @@index([scope, status, createdAt])
  @@map("orders")
  @@schema("orai")
}

model CodeBatch {
  id        String           @id @default(uuid(7)) @db.Uuid
  orderId   String           @map("order_id") @db.Uuid
  order     Order            @relation(fields: [orderId, scope], references: [id, scope], onDelete: Restrict)
  scope     DataScope
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  codes     RedemptionCode[]

  @@unique([id, orderId, scope])
  @@index([orderId])
  @@map("code_batches")
  @@schema("orai")
}

model RedemptionCode {
  id               String          @id @default(uuid(7)) @db.Uuid
  digest           String          @unique
  scope            DataScope
  status           CodeStatus      @default(ISSUED)
  orderId          String          @map("order_id") @db.Uuid
  productVersionId String          @map("product_version_id") @db.Uuid
  order            Order           @relation(fields: [orderId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict)
  productVersion   ProductVersion  @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  batchId          String?         @map("batch_id") @db.Uuid
  batch            CodeBatch?      @relation(fields: [batchId, orderId, scope], references: [id, orderId, scope], onDelete: Restrict)
  entitlementId    String?         @map("entitlement_id") @db.Uuid
  entitlement      Entitlement?    @relation(fields: [entitlementId, orderId, productVersionId, scope], references: [id, orderId, productVersionId, scope], onDelete: Restrict, map: "redemption_codes_entitlement_delivery_fkey")
  replacesCodeId   String?         @unique @map("replaces_code_id") @db.Uuid
  replacesCode     RedemptionCode? @relation("Replacement", fields: [replacesCodeId, orderId, productVersionId, scope], references: [id, orderId, productVersionId, scope], onDelete: Restrict, map: "redemption_codes_replacement_delivery_fkey")
  replacement      RedemptionCode? @relation("Replacement")
  claimDeadline    DateTime        @map("claim_deadline") @db.Timestamptz(3)
  claimedAt        DateTime?       @map("claimed_at") @db.Timestamptz(3)
  revokedAt        DateTime?       @map("revoked_at") @db.Timestamptz(3)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([id, orderId, productVersionId, scope], map: "redemption_codes_delivery_key")
  @@unique([replacesCodeId, orderId, productVersionId, scope], map: "redemption_codes_replacement_key")
  @@index([orderId])
  @@index([batchId])
  @@index([entitlementId])
  @@index([productVersionId, scope])
  @@index([scope, status, claimDeadline])
  @@map("redemption_codes")
  @@schema("orai")
}

model User {
  id             String               @id @default(uuid(7)) @db.Uuid
  supabaseUserId String               @unique @map("supabase_user_id") @db.Uuid
  assetFiles     AssetFile[]
  skillVersions StyleSkillVersion[]
  skillReferenceFiles SkillReferenceFile[]
  productionRecords ProductionRecord[]
  scope          DataScope
  role           UserRole             @default(USER)
  disabledAt     DateTime?            @map("disabled_at") @db.Timestamptz(3)
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)
  entitlements   Entitlement[]
  bindings       EntitlementBinding[]
  auditLogs      AdminAuditLog[]
  accountSessions AccountSession[]
  machineCredentials MachineCredential[]
  machineWorkspaces MachineProjectWorkspace[]

  @@unique([id, scope])
  @@map("users")
  @@schema("orai")
  contentReviews ContentReviewRecord[]
  contentPackages ContentPackage[]
  fileCleanups FileCleanupPlan[]
  experienceAuthoring ExperienceAuthoringRevision[]
  productionPlans ProductionPlanRevision[]
  projectMethods ProjectMethodSnapshot[]
  projectProductions ProjectProductionRecord[]
  projectOriginals ProjectOriginalFile[]
  projectReviews ProjectReviewRevision[]
  cancelledProductionRuns ExternalProductionRun[]
  canvasLayouts ProjectCanvasLayoutRevision[]
  codexConnections CodexConnection[]
  externalConfigurations ExternalRunConfiguration[]
  externalConfigurationRevisions ExternalRunConfigurationRevision[]
}

model AccountSession {
  id                  String    @id @default(uuid(7)) @db.Uuid
  userId              String    @map("user_id") @db.Uuid
  scope               DataScope
  user                User      @relation(fields: [userId, scope], references: [id, scope], onDelete: Restrict)
  supabaseSessionId   String    @map("supabase_session_id") @db.Uuid
  tokenDigest         String    @unique @map("token_digest")
  accessCredential    String?   @map("access_credential")
  refreshCredential   String?   @map("refresh_credential")
  accessExpiresAt     DateTime  @map("access_expires_at") @db.Timestamptz(3)
  expiresAt           DateTime  @map("expires_at") @db.Timestamptz(3)
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  revokedAt           DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@unique([id, scope])
  @@unique([supabaseSessionId, scope])
  @@index([userId, scope, revokedAt])
  @@index([expiresAt])
  @@map("account_sessions")
  @@schema("orai")
}

model Entitlement {
  id               String              @id @default(uuid(7)) @db.Uuid
  productVersionId String              @map("product_version_id") @db.Uuid
  scope            DataScope
  productVersion   ProductVersion      @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  orderId          String              @map("order_id") @db.Uuid
  order            Order               @relation(fields: [orderId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict)
  ownership        Ownership           @default(ANONYMOUS)
  ownerUserId      String?             @map("owner_user_id") @db.Uuid
  ownerUser        User?               @relation(fields: [ownerUserId, scope], references: [id, scope], onDelete: Restrict)
  status           EntitlementStatus   @default(ACTIVE)
  reportsAllowed   Int                 @default(1) @map("reports_allowed")
  reportsConsumed  Int                 @default(0) @map("reports_consumed")
  claimedAt        DateTime            @map("claimed_at") @db.Timestamptz(3)
  accessExpiresAt  DateTime            @map("access_expires_at") @db.Timestamptz(3)
  boundAt          DateTime?           @map("bound_at") @db.Timestamptz(3)
  revokedAt        DateTime?           @map("revoked_at") @db.Timestamptz(3)
  codes            RedemptionCode[]
  attempts         Attempt[]
  grants           AccessGrant[]
  binding          EntitlementBinding?

  @@unique([id, scope])
  @@unique([id, productVersionId, scope])
  @@unique([id, orderId, productVersionId, scope], map: "entitlements_delivery_key")
  @@unique([id, ownerUserId])
  @@index([orderId])
  @@index([productVersionId, scope])
  @@index([ownerUserId, scope, status, claimedAt])
  @@map("entitlements")
  @@schema("orai")
}

model AccessSession {
  id          String        @id @default(uuid(7)) @db.Uuid
  tokenDigest String        @unique @map("token_digest")
  scope       DataScope
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt   DateTime      @map("expires_at") @db.Timestamptz(3)
  revokedAt   DateTime?     @map("revoked_at") @db.Timestamptz(3)
  grants      AccessGrant[]

  @@unique([id, scope])
  @@index([expiresAt])
  @@map("access_sessions")
  @@schema("orai")
}

model AccessGrant {
  sessionId     String        @map("session_id") @db.Uuid
  entitlementId String        @map("entitlement_id") @db.Uuid
  scope         DataScope
  session       AccessSession @relation(fields: [sessionId, scope], references: [id, scope], onDelete: Cascade)
  entitlement   Entitlement   @relation(fields: [entitlementId, scope], references: [id, scope], onDelete: Restrict)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  revokedAt     DateTime?     @map("revoked_at") @db.Timestamptz(3)

  @@id([sessionId, entitlementId])
  @@index([entitlementId])
  @@map("access_grants")
  @@schema("orai")
}

model EntitlementBinding {
  entitlementId String      @id @map("entitlement_id") @db.Uuid
  userId        String      @map("user_id") @db.Uuid
  entitlement   Entitlement @relation(fields: [entitlementId, userId], references: [id, ownerUserId], onDelete: Restrict)
  user          User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([entitlementId, userId])
  @@index([userId, createdAt])
  @@map("entitlement_bindings")
  @@schema("orai")
}

model ExperienceAuthoringRevision {
  id String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  productVersionId String @map("product_version_id") @db.Uuid
  scope DataScope
  productVersion ProductVersion @relation(fields: [productVersionId, productId, scope], references: [id, productId, scope], onDelete: Restrict, map: "experience_authoring_version_scope_fkey")
  creativeProfileRevisionId String @map("creative_profile_revision_id") @db.Uuid
  creativeProfile CreativeProfileRevision @relation(fields: [creativeProfileRevisionId, productId, scope], references: [id, productId, scope], onDelete: Restrict, map: "experience_authoring_profile_scope_fkey")
  number Int
  status String
  versionRevision Int @map("version_revision")
  configurationDigest String @map("configuration_digest")
  manifest Json
  reportPlan Json @map("report_plan")
  methods Json
  note String
  source String
  actorUserId String @map("actor_user_id") @db.Uuid
  actor User @relation(fields: [actorUserId, scope], references: [id, scope], onDelete: Restrict)
  projectPlanModuleId String? @map("project_plan_module_id") @db.Uuid
  projectModule ProductionPlanModule? @relation(fields:[projectPlanModuleId,productId,scope],references:[id,productId,scope],onDelete:Restrict)
  machineCredentialId String? @map("machine_credential_id") @db.Uuid
  machineCredential MachineCredential? @relation(fields: [machineCredentialId, scope], references: [id, scope], onDelete: Restrict)
  machineRequestId String? @map("machine_request_id") @db.Uuid
  digest String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  resources ExperienceAuthoringResource[]
  releases ExperienceRelease[]
  projectOutputs ProjectProductionOutput[]

  @@unique([id, productId, scope])

  @@unique([productVersionId, number])
  @@unique([id, productVersionId, scope])
  @@map("experience_authoring_revisions")
  @@schema("orai")
  candidateDrafts ProjectCandidateDraft[]
}

model ExperienceAuthoringResource {
  id String @id @default(uuid(7)) @db.Uuid
  revisionId String @map("revision_id") @db.Uuid
  productVersionId String @map("product_version_id") @db.Uuid
  scope DataScope
  revision ExperienceAuthoringRevision @relation(fields: [revisionId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "experience_authoring_resources_revision_scope_fkey")
  resourceId String @map("resource_id")
  fileId String @map("file_id") @db.Uuid
  file AssetFile @relation(fields: [fileId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "experience_authoring_resources_file_scope_fkey")

  @@unique([revisionId, resourceId])
  @@index([fileId])
  @@map("experience_authoring_resources")
  @@schema("orai")
}

model ExperienceRelease {
  id String @id @default(uuid(7)) @db.Uuid
  productId String @map("product_id") @db.Uuid
  productVersionId String @unique @map("product_version_id") @db.Uuid
  scope DataScope
  productVersion ProductVersion @relation(fields: [productVersionId, productId, scope], references: [id, productId, scope], onDelete: Restrict, map: "experience_releases_version_scope_fkey")
  creativeProfileRevisionId String? @map("creative_profile_revision_id") @db.Uuid
  creativeProfile CreativeProfileRevision? @relation(fields: [creativeProfileRevisionId, productId, scope], references: [id, productId, scope], onDelete: Restrict, map: "experience_releases_profile_scope_fkey")
  manifest Json
  digest String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  attempts Attempt[]
  resources ExperienceResource[]
  authoringRevisionId String? @map("authoring_revision_id") @db.Uuid
  authoringRevision ExperienceAuthoringRevision? @relation(fields: [authoringRevisionId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "experience_release_authoring_scope_fkey")

  @@unique([id, productVersionId, scope])
  @@unique([productVersionId, productId, scope])
  @@map("experience_releases")
  @@schema("orai")
}

model ExperienceResource {
  id String @id @default(uuid(7)) @db.Uuid
  releaseId String @map("release_id") @db.Uuid
  productVersionId String @map("product_version_id") @db.Uuid
  scope DataScope
  release ExperienceRelease @relation(fields: [releaseId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "experience_resources_release_scope_fkey")
  resourceId String @map("resource_id")
  fileId String @map("file_id") @db.Uuid
  file AssetFile @relation(fields: [fileId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "experience_resources_file_scope_fkey")
  purpose String
  checksum String
  byteSize Int @map("byte_size")
  mimeType String @map("mime_type")

  @@unique([releaseId, resourceId])
  @@index([fileId])
  @@map("experience_resources")
  @@schema("orai")
}

model Attempt {
  id               String          @id @default(uuid(7)) @db.Uuid
  entitlementId    String          @map("entitlement_id") @db.Uuid
  productVersionId String          @map("product_version_id") @db.Uuid
  scope            DataScope
  entitlement      Entitlement     @relation(fields: [entitlementId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict)
  productVersion   ProductVersion  @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  experienceReleaseId String? @map("experience_release_id") @db.Uuid
  experienceRelease ExperienceRelease? @relation(fields: [experienceReleaseId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict, map: "attempt_experience_scope_fkey")
  runtimeCheckpoint Json? @map("runtime_checkpoint")
  ordinal          Int             @default(1)
  status           AttemptStatus   @default(STARTED)
  revision         Int             @default(0)
  statsValid       Boolean         @default(true) @map("stats_valid")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  submittedAt      DateTime?       @map("submitted_at") @db.Timestamptz(3)
  completedAt      DateTime?       @map("completed_at") @db.Timestamptz(3)
  invalidatedAt    DateTime?       @map("invalidated_at") @db.Timestamptz(3)
  answersExpireAt  DateTime?       @map("answers_expire_at") @db.Timestamptz(3)
  answers          AttemptAnswer[]
  report           Report?

  @@unique([entitlementId, ordinal])
  @@unique([id, productVersionId, scope])
  @@index([productVersionId, scope, status, statsValid])
  @@index([answersExpireAt, status])
  @@map("attempts")
  @@schema("orai")
}

model AttemptAnswer {
  attemptId  String   @map("attempt_id") @db.Uuid
  questionId String   @map("question_id")
  optionId   String   @map("option_id")
  revision   Int      @default(1)
  savedAt    DateTime @default(now()) @map("saved_at") @db.Timestamptz(3)
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@id([attemptId, questionId])
  @@map("attempt_answers")
  @@schema("orai")
}

model Report {
  id               String         @id @default(uuid(7)) @db.Uuid
  attemptId        String         @unique @map("attempt_id") @db.Uuid
  productVersionId String         @map("product_version_id") @db.Uuid
  scope            DataScope
  attempt          Attempt        @relation(fields: [attemptId, productVersionId, scope], references: [id, productVersionId, scope], onDelete: Restrict)
  productVersion   ProductVersion @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  resultTypeId     String         @map("result_type_id")
  snapshot         Json?
  presentation     Json?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt        DateTime       @map("expires_at") @db.Timestamptz(3)
  deletedAt        DateTime?      @map("deleted_at") @db.Timestamptz(3)

  @@unique([attemptId, productVersionId, scope])
  @@index([productVersionId, scope])
  @@index([expiresAt])
  @@map("reports")
  @@schema("orai")
}

model QuestionStat {
  productVersionId String               @map("product_version_id") @db.Uuid
  questionId       String               @map("question_id")
  scope            DataScope
  productVersion   ProductVersion       @relation(fields: [productVersionId, scope], references: [id, scope], onDelete: Restrict)
  answerCount      Int                  @default(0) @map("answer_count")
  updatedAt        DateTime             @default(now()) @map("updated_at") @db.Timestamptz(3)
  options          QuestionOptionStat[]

  @@id([productVersionId, questionId])
  @@map("question_stats")
  @@schema("orai")
