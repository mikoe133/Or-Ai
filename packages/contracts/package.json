{
  "name": "@orai/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./private": {
      "types": "./dist/private.d.ts",
      "import": "./dist/private.js",
      "default": "./dist/private.js"
    },
    "./experience": {
      "types": "./dist/experience.d.ts",
      "import": "./dist/experience.js",
      "default": "./dist/experience.js"
    },
    "./admin": {
      "types": "./dist/admin.d.ts",
      "import": "./dist/admin.js",
      "default": "./dist/admin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
