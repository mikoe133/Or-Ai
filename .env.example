# Copy via pnpm local:setup; real local values belong only in gitignored .env.
APP_ENV=development
API_PORT=4100
API_HOST=127.0.0.1
WEB_PORT=5173
POSTGRES_PORT=55432
POSTGRES_USER=orai
POSTGRES_DB=orai_dev
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_OWNER_PASSWORD
# Migration owner and application account have separate credentials.
MIGRATION_DATABASE_URL=postgresql://orai:REPLACE_WITH_LOCAL_OWNER_PASSWORD@127.0.0.1:55432/orai_dev?schema=orai
DATABASE_URL=postgresql://orai_app:REPLACE_WITH_LOCAL_APP_PASSWORD@127.0.0.1:55432/orai_dev?schema=orai
DATABASE_CONTAINER_URL=postgresql://orai_app:REPLACE_WITH_LOCAL_APP_PASSWORD@db:5432/orai_dev?schema=orai
DEMO_SEED_DATABASE=orai_dev
DATABASE_SSL_MODE=disable
DATABASE_POOL_MAX=5
# Production requires HTTPS public origins and a stable random CSRF key.
# Leave APP_PUBLIC_ORIGIN empty locally to permit only local Web/API origins.
APP_PUBLIC_ORIGIN=
CSRF_SIGNING_KEY=REPLACE_WITH_LOCAL_CSRF_SECRET
TRUST_PROXY_CIDRS=
ANONYMOUS_SESSION_DAYS=30
CSRF_TTL_SECONDS=3600
REDEMPTION_IP_LIMIT=30
REDEMPTION_CODE_LIMIT=20
REDEMPTION_WINDOW_SECONDS=900
ANONYMOUS_READ_IP_LIMIT=120
ANONYMOUS_WRITE_IP_LIMIT=120
# Local uploads are development/test only; production rejects driver=local.
# Relative paths resolve from the API process working directory (apps/api).
ASSET_STORAGE_DRIVER=local
ASSET_DIRECTORY=.local/assets
ASSET_MAX_IMAGE_BYTES=10485760
ASSET_MAX_VIDEO_BYTES=104857600
# Auth is configured in T06. Never place database/admin secrets in VITE_ variables.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only, stable 32-byte base64url key; local:setup generates it locally.
AUTH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_LOCAL_AUTH_SECRET
ACCOUNT_SESSION_DAYS=30
AUTH_REQUEST_TIMEOUT_MS=8000
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Required for configured production Auth, exact HTTPS site origin.
VITE_APP_PUBLIC_ORIGIN=
