# Offline inventory only. Do not upload this entire file to the API container.
# Fill an ignored copy using provider secret management; never commit real values.
NODE_ENV=production
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=4100
APP_PUBLIC_ORIGIN=https://meetmyworld.com
CSRF_SIGNING_KEY=REPLACE_WITH_STABLE_RANDOM_BASE64URL_SECRET
# Canonical VPS Compose proxy address; Task08 must verify the real topology.
TRUST_PROXY_CIDRS=172.30.84.2/32

# API runtime: restricted DML role, not postgres/owner/service-role.
# Both examples use Session Pooler port 5432. Verify role grants and TLS in T09.3.
DATABASE_URL=postgresql://orai_app.PROJECT_REF:REPLACE_WITH_RUNTIME_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=orai
DATABASE_SSL_MODE=verify-full
DATABASE_POOL_MAX=5

# Migration runner only. Never inject this value into the running API or Vite.
# Separate db:cloud maintenance command only; local provisioning still refuses cloud DBs.
MIGRATION_DATABASE_URL=postgresql://orai_owner.PROJECT_REF:REPLACE_WITH_MIGRATION_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=orai

# API Auth. Publishable/legacy anon key only, never service_role or sb_secret_.
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PROJECT_PUBLISHABLE_KEY
AUTH_SESSION_ENCRYPTION_KEY=REPLACE_WITH_DISTINCT_STABLE_32_BYTE_BASE64URL_KEY
ACCOUNT_SESSION_DAYS=30
AUTH_REQUEST_TIMEOUT_MS=8000

# Frontend build only. These three values are public and must match API Auth/origin.
VITE_APP_PUBLIC_ORIGIN=https://meetmyworld.com
VITE_SUPABASE_URL=https://PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PROJECT_PUBLISHABLE_KEY

# R2 code has local protocol validation. Real bucket permissions are Task08.
ASSET_STORAGE_DRIVER=r2
ASSET_MAX_IMAGE_BYTES=10485760
ASSET_MAX_VIDEO_BYTES=104857600
R2_ACCOUNT_ID=REPLACE_WITH_EXISTING_R2_ACCOUNT_ID
R2_BUCKET=REPLACE_WITH_EXISTING_PRIVATE_BUCKET
R2_ACCESS_KEY_ID=REPLACE_WITH_EXISTING_SCOPED_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=REPLACE_WITH_EXISTING_SCOPED_SECRET
# Explicit raw-binary request body budget, below a 100MB proxy ceiling.
# Effective limits are min(purpose limit, ingress - envelope), in exact bytes.
UPLOAD_INGRESS_BODY_BYTES=90000000
UPLOAD_REQUEST_ENVELOPE_BYTES=0
ASSET_UPLOAD_TIMEOUT_MS=360000
R2_REQUEST_TIMEOUT_MS=360000
# Compose fixes the API spool at 256MiB / 2 files with a 320MiB tmpfs.
# Local stdio MCP config: ORAI_MCP_UPLOAD_TIMEOUT_MS=360000 when appropriate.
# This does not enable remote MCP or remove its loopback restriction.

# Supabase dashboard: Site URL https://meetmyworld.com
# Allowed redirects: https://meetmyworld.com/auth/callback
#                   https://meetmyworld.com/auth/reset
# Resend SMTP and DNS verification are configured in the providers, not VITE_*.
