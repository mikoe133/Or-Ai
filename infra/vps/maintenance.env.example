# Separate, private, maintenance-only file. Replace placeholders in an ignored
# absolute path, chmod 600, then preview. Never inject this into the API or Vite.
APP_ENV=production
NODE_ENV=production
DATABASE_SSL_MODE=verify-full
CLOUD_DATABASE_PROJECT_REF=REPLACE_WITH_EXISTING_20_CHARACTER_PROJECT_REF
CLOUD_DATABASE_EXPECTED_HOST=REPLACE_WITH_EXISTING_SESSION_POOLER_HOST
CLOUD_DATABASE_NAME=postgres
CLOUD_DATABASE_CA_FILE=/run/maintenance/supabase-ca.pem
CLOUD_DATABASE_CA_SHA256=REPLACE_WITH_VERIFIED_PUBLIC_CA_SHA256
CLOUD_DATABASE_BOOTSTRAP_URL=postgresql://postgres.PROJECT_REF:REPLACE_WITH_MANAGEMENT_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=orai
MIGRATION_DATABASE_URL=postgresql://orai_owner.PROJECT_REF:REPLACE_WITH_DISTINCT_MIGRATION_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=orai
DATABASE_URL=postgresql://orai_app.PROJECT_REF:REPLACE_WITH_DISTINCT_RUNTIME_PASSWORD@REGION.pooler.supabase.com:5432/postgres?schema=orai
