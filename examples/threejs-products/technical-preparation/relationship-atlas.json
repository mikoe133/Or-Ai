        },
        "feedback": {
          "requirement": "required",
          "status": "planned",
          "details": "清楚呈现选中/未确认/保存中/失败，颜色配文字和焦点，不从镜头角度或动画路径得分。",
          "evidence": []
        },
        "confirmation": {
          "requirement": "required",
          "status": "planned",
          "details": "明确确认按钮触发既有保存；保留expectedRevision/requestId和一次消费语义，不自动提交。",
          "evidence": []
        },
        "recovery": {
          "requirement": "required",
          "status": "planned",
          "details": "以服务器确认答案恢复；当前未确认输入单独保留，断网/未知写入结果复用相同requestId，不换题或复制消费。",
          "evidence": []
        },
        "accessibility": {
          "requirement": "required",
          "status": "planned",
          "details": "同题文字及键盘/触摸操作、焦点、减少动态和长文重排；真实设备后续验收。",
          "evidence": []
        },
        "fallback": {
          "requirement": "required",
          "status": "planned",
          "details": "无WebGL2、模块/资源加载失败或context丢失时使用同题同选项的DOM文字/故障回退，不把回退当正常Three.js交付。",
          "evidence": []
        },
        "resources": {
          "requirement": "required",
          "status": "planned",
          "details": "先用仓库内可信几何体；没有导入实际媒体/GLB/音频/脚本，没有把ZIP原件当可执行代码。",
          "evidence": []
        },
        "scene": {
          "requirement": "required",
          "status": "planned",
          "details": "拟用Three.js正交分层坐标台呈现单人关系观察，暖灰纸色和有限紫色刻线；前后层承担选项语义，不用花园/DOM小屋冒充这个模板。",
          "evidence": []
        },
        "camera": {
          "requirement": "required",
          "status": "planned",
          "details": "固定正交视角，不提供自由漫游、拖动旋转或镜头过渡；窄屏按语义重新排布，不能硬裁切正文。",
          "evidence": []
        },
        "report": {
          "requirement": "required",
          "status": "planned",
          "details": "拟制作地图手记报告模板atlas-notes-prototype，保留标准结构化结果；未注册/未实现，不自动回退花园手记冒称配套完成。",
          "evidence": []
        },
